{
  "name": "github-auto-switch",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that opens every GitHub page with the right account, by your rules.",
  "type": "module",
  "scripts": {
    "test": "node --test test/rules.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "test:e2e:safari": "SAFARI=1 node --test test/e2e.test.js",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "icons": "node scripts/make-icons.mjs",
    "start:firefox": "web-ext run --target firefox-desktop",
    "start:chromium": "web-ext run --target chromium"
  },
  "devDependencies": {
    "node-forge": "1.4.4",
    "playwright": "^1.55.0",
    "web-ext": "^8.10.0"
  }
}
