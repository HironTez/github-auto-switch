{
  "name": "github-auto-switch",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that automatically switches between GitHub accounts.",
  "scripts": {
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "start:firefox": "web-ext run --target firefox-desktop",
    "start:chromium": "web-ext run --target chromium"
  },
  "devDependencies": {
    "web-ext": "^8.10.0"
  }
}
