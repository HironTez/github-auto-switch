{
  "manifest_version": 3,
  "name": "GitHub Auto Switch",
  "version": "0.1.0",
  "description": "Automatically switches between GitHub accounts.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "GitHub Auto Switch",
    "default_popup": "src/popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "github-auto-switch@hirontez",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
